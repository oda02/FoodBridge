food.kukakur.ru {
    root * /opt/foodbridge/site
    encode zstd gzip
    header {
        Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
    @assetlinks path /.well-known/assetlinks.json
    header @assetlinks Content-Type application/json
    header @assetlinks Cache-Control "public, max-age=300"
    # No access log directive: nutrition is never logged by this static site.
    file_server
}
